{
  "manifest_version": 3,
  "name": "Prickly",
  "version": "0.1.0",
  "description": "browser use! but slightly less prickly",
  "minimum_chrome_version": "116",
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "permissions": [
    "debugger",
    "tabs",
    "tabGroups",
    "scripting",
    "storage",
    "alarms",
    "offscreen",
    "nativeMessaging"
  ],
  "host_permissions": ["<all_urls>"],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Prickly"
  },
  "icons": {}
}
